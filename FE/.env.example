# Optional override for the API root.
# Defaults: development uses `/api` through the Vite proxy; production uses
# `https://api.chainstore.site/api` directly.
# VITE_API_BASE_URL=http://localhost:4313/api
#
# Production site: https://chainstore.site
# Forgot-password emails use window.location.origin (or BE CLIENT_URL fallback).
# Ensure BE CLIENT_URL=https://chainstore.site when deploying.
VITE_APP_NAME=ChainStore
