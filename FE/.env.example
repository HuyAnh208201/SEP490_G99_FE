# Leave VITE_API_BASE_URL empty for local Vite: FE uses baseURL `/api` and the
# Vite proxy forwards to backend http://localhost:4313.
# For static/prod deploy (no proxy), set the public API root, e.g.:
# VITE_API_BASE_URL=https://api.chainstore.site/api
# VITE_API_BASE_URL=http://localhost:4313/api
VITE_APP_NAME=ChainStore
