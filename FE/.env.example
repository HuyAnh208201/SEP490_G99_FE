# Để trống VITE_API_BASE_URL khi chạy dev: FE dùng baseURL `/api` và Vite proxy sang backend localhost:4313.
# Chỉ set khi deploy hoặc muốn gọi thẳng API (không qua proxy), ví dụ: http://localhost:4313/api
# VITE_API_BASE_URL=http://localhost:4313/api
VITE_APP_NAME=ChainStore
# Purchase request mock: set true only for offline UI dev
# VITE_PR_MOCK=true
# Auto-fallback to mock when BE unavailable (default false for demo)
VITE_PR_MOCK_FALLBACK=false
